# ============================================================
# UNDANGAN — Environment Variables (TEMPLATE / dokumentasi)
# ============================================================
# Salin file ini:  cp .env.example .env   (lalu isi nilainya)
# Catatan: nilai SITE_URL / GOOGLE_REDIRECT_URI adalah publik,
#          sedangkan CLIENT_SECRET / DB password wajib dirahasiakan.
#
# Deploy ke Netlify: isi var yang sama di
#   Netlify -> Site configuration -> Environment variables
# ============================================================

# --- SUPABASE ---
SUPABASE_URL=https://uvngztroskottsfxtgoq.supabase.co
SUPABASE_ANON_KEY=ganti_dengan_anon_key_dari_supabase_dashboard

# --- DATABASE (jangan diekspos publik) ---
SUPABASE_DB_PASSWORD=ganti_dengan_password_db
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- NETLIFY / SITE ---
SITE_URL=https://polite-conkies-335e5f.netlify.app
GOOGLE_REDIRECT_URI=https://polite-conkies-335e5f.netlify.app/auth/google/callback

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=ganti_dengan_client_id
GOOGLE_CLIENT_SECRET=ganti_dengan_client_secret